# Nexus Terminal — environment configuration
# Copy to .env (or set in your host's dashboard). Never commit real values.

# Gemini API key — used server-side for the AI copy / chat helpers.
GEMINI_API_KEY=""

# Public URL where this app is hosted. Used for self-referential links
# and webhook / callback URLs.
APP_URL=""

# Whop API key — used server-side to verify memberships and licenses.
WHOP_API_KEY=""

# Whop webhook secret — used to verify webhook signatures.
# It is shown only once when you create the webhook in Whop; capture it then.
WHOP_WEBHOOK_SECRET=""

# Your Whop App ID and Company ID, from your Whop developer dashboard.
# There are no built-in defaults — Nexus Terminal reports
# "not configured" until these are set.
WHOP_APP_ID=""
WHOP_COMPANY_ID=""
NEXT_PUBLIC_WHOP_APP_ID=""
VITE_WHOP_APP_ID=""

# Postgres connection string for passes, reviews, webhook logs, and
# processed-event tracking. Required in production — without it,
# database operations fail (the server still boots and warns).
DATABASE_URL=""
